{
  "name": "@linebundle-sdk/ts",
  "version": "1.0.0-rc.24",
  "description": "Auto-generated, type-safe TypeScript client for the LineBundle API.",
  "author": "LineBundle",
  "license": "MIT",
  "keywords": [
    "linebundle",
    "sdk",
    "typescript",
    "openapi",
    "events",
    "spaces",
    "api-client",
    "type-safe"
  ],
  "homepage": "https://docs.linebundle.com/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "https://github.com/LineBundle/linebundle-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/LineBundle/linebundle-sdks/issues"
  },
  "type": "module",
  "main": "./esm/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint --cache --max-warnings=0 src",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
